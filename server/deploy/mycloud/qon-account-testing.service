[Unit]
Description=Qonlang and Qonsona shared accounts (isolated testing)
After=network.target
[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qon-account-service
EnvironmentFile=/home/ubuntu/qon-account-data/testing.env
ExecStart=/home/ubuntu/qon-runtime/node-v24.14.1-linux-x64/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/qon-account-data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=384M
[Install]
WantedBy=multi-user.target
