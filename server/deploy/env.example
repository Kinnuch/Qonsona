# Copy outside the checkout; permissions 0600. No secrets are included here.
NODE_ENV=production
QON_HOST=127.0.0.1
QON_PORT=8787
QON_DB=/var/lib/qonaccounts/accounts.sqlite
QON_TRUST_PROXY=1
QON_SUPPORT_TICKET_FEN=600
QON_PAYMENTS_ENABLED=0
# Empty disables admin approval. Generate >=32 random characters on deployment.
QON_ADMIN_KEY=
# Production ignores the grant flag even if accidentally set to1.
QON_TEST_GRANTS=0
QON_TEST_EPOCH=production-disabled
