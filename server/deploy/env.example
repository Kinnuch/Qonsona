# Copy outside the checkout; permissions 0600. No secrets are included here.
NODE_ENV=production
QON_HOST=127.0.0.1
QON_PORT=8787
QON_DB=/var/lib/qonaccounts/accounts.sqlite
QON_TRUST_PROXY=1
QON_SUPPORT_TICKET_FEN=600
# Default off. Set 1 only after the fresh production DB, HTTPS callback and
# merchant configuration are verified. All three YunGouOS fields are required.
QON_PAYMENTS_ENABLED=0
QON_YUNGOUOS_MCH_ID=
QON_YUNGOUOS_PAY_KEY=
QON_YUNGOUOS_NOTIFY_URL=https://kinnuch.cn/qon-api/v1/payments/yungouos/notify
# Live creation also requires X-Qon-Payment-Protocol: yungouos-wechat-v1 from
# the updated desktop main process. Never put merchant keys in that header.
# Current merchant dashboard limit: CNY 10/day. This is not an application env
# option. The separate account limit remains 6000 fen/calendar month.
# Empty disables admin approval. Generate >=32 random characters on deployment.
QON_ADMIN_KEY=
# Production ignores the grant flag even if accidentally set to1.
QON_TEST_GRANTS=0
QON_TEST_EPOCH=production-disabled
