{
  "name": "qonsona",
  "version": "0.1.0",
  "description": "Qonsona — learn languages: Japanese first, plus the conlangs you build in Qonlang.",
  "homepage": "https://github.com/Kinnuch/Qonsona",
  "main": "./out/main/index.js",
  "author": {
    "name": "Kinnuch"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "sync:qonlang": "node scripts/sync-qonlang.mjs",
    "data:ja": "node scripts/data/build-ja.mjs",
    "data:examples": "esbuild scripts/data/examples-ja.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=.cache/examples-ja.mjs && node .cache/examples-ja.mjs",
    "grammar:probe": "node scripts/data/run-ts.mjs scripts/data/grammar-probe.ts",
    "data:levels": "esbuild scripts/data/article-levels.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=.cache/article-levels.mjs && node .cache/article-levels.mjs",
    "pack:win": "bash scripts/pack-win.sh",
    "installer:win": "bash scripts/pack-win.sh && electron-builder --win nsis --prepackaged dist/win-unpacked --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lucide/svelte": "^1.42.0",
    "electron-updater": "^6.8.9",
    "kuromoji": "^0.1.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.19.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "fflate": "^0.8.3",
    "opentype.js": "^2.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "seek-bzip": "^2.0.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.0"
  }
}
